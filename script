                </div>

            </div>

        `;

        emChatBody.appendChild(wrapper);

        emScrollChat();

    }


    /* =====================================================
       SEND TEXT MESSAGE
    ===================================================== */

    window.emSendMessage = function () {

        if (!emChatInput) return;

        const message =
            emChatInput.value.trim();

        if (!message) return;

        emAddUserMessage(message);

        emChatInput.value = "";

        setTimeout(function () {

            emProcessText(message);

        }, 500);

    };


    /* =====================================================
       ENTER KEY
    ===================================================== */

    window.emHandleChatKey = function (event) {

        if (event.key === "Enter") {

            event.preventDefault();

            emSendMessage();

        }

    };


    /* =====================================================
       SIMPLE CHAT INTELLIGENCE
    ===================================================== */

    function emProcessText(message) {

        const text =
            message.toLowerCase();


        if (
            text.includes("amenit") ||
            text.includes("facility") ||
            text.includes("facilities") ||
            text.includes("clubhouse") ||
            text.includes("club house")
        ) {

            emGenerateBotResponse("amenities");

            return;

        }


        if (
            text.includes("master") ||
            text.includes("layout") ||
            text.includes("plan")
        ) {

            emGenerateBotResponse("masterplan");

            return;

        }


        if (
            text.includes("location") ||
            text.includes("where") ||
            text.includes("connect") ||
            text.includes("ghatkesar")
        ) {

            emGenerateBotResponse("location");

            return;

        }


        if (
            text.includes("visit") ||
            text.includes("site")
        ) {

            emGenerateBotResponse("visit");

            return;

        }


        if (
            text.includes("project") ||
            text.includes("about") ||
            text.includes("eastern")
        ) {

            emGenerateBotResponse("project");

            return;

        }


        emAddBotMessage(`
            I can help you with:

            <br><br>

            🏡 Project Details<br>
            ✨ Amenities<br>
            🗺 Master Plan<br>
            📍 Location<br>
            📅 Site Visit

            <div class="em-response-buttons">

                <button onclick="emBotReply('project')">
                    Project
                </button>

                <button onclick="emBotReply('amenities')">
                    Amenities
                </button>

                <button onclick="emBotReply('location')">
                    Location
                </button>

                <button onclick="emBotReply('visit')">
                    Site Visit
                </button>

            </div>
        `);

    }


    /* =====================================================
       SCROLL CHAT
    ===================================================== */

    function emScrollChat() {

        if (!emChatBody) return;

        setTimeout(function () {

            emChatBody.scrollTo({
                top: emChatBody.scrollHeight,
                behavior: "smooth"
            });

        }, 50);

    }


    /* =====================================================
       GO TO WEBSITE SECTION
    ===================================================== */

    window.emGoToSection = function (sectionId) {

        emCloseChat();

        setTimeout(function () {

            const section =
                document.getElementById(sectionId);

            if (section) {

                section.scrollIntoView({
                    behavior: "smooth",
                    block: "start"
                });

            }

        }, 200);

    };


    /* =====================================================
       ENQUIRY SUBMISSION
    ===================================================== */

    window.emSubmitEnquiry = function (event) {

        event.preventDefault();

        const name =
            document.getElementById("emName").value.trim();

        const phone =
            document.getElementById("emPhone").value.trim();

        const email =
            document.getElementById("emEmail").value.trim();

        const date =
            document.getElementById("emVisitDate").value;

        const time =
            document.getElementById("emVisitTime").value;

        const interest =
            document.getElementById("emInterest").value;

        const whatsapp =
            document.getElementById(
                "emWhatsAppUpdates"
            ).checked;


        if (!/^[0-9]{10}$/.test(phone)) {

            alert(
                "Please enter a valid 10-digit mobile number."
            );

            return;

        }


        let message =
            "Hello Eastern Meadows,%0A%0A" +

            "I would like to enquire about the project.%0A%0A" +

            "Name: " +
            encodeURIComponent(name) +

            "%0APhone: " +
            encodeURIComponent(phone);


        if (email) {

            message +=
                "%0AEmail: " +
                encodeURIComponent(email);

        }


        if (date) {

            message +=
                "%0APreferred Visit Date: " +
                encodeURIComponent(date);

        }


        if (time) {

            message +=
                "%0APreferred Time: " +
                encodeURIComponent(time);

        }


        message +=
            "%0AInterested In: " +
            encodeURIComponent(interest);


        if (whatsapp) {

            message +=
                "%0A%0AI would also like to receive updates on WhatsApp.";

        }


        const whatsappURL =
            "https://wa.me/" +
            EM_WHATSAPP_NUMBER +
            "?text=" +
            message;


        emCloseEnquiry();


        /*
         * Open WhatsApp after submission.
         * This makes the enquiry functional immediately
         * without requiring a backend.
         */

        window.open(
            whatsappURL,
            "_blank",
            "noopener,noreferrer"
        );


        /*
         * Reset form
         */

        const form =
            document.getElementById(
                "emEnquiryForm"
            );

        if (form) {
            form.reset();
        }

    };


    /* =====================================================
       ESCAPE HTML
    ===================================================== */

    function emEscapeHTML(text) {

        const div =
            document.createElement("div");

        div.textContent = text;

        return div.innerHTML;

    }


    /* =====================================================
       INITIAL NOTIFICATION
       Appears after 8 seconds.
    ===================================================== */

    setTimeout(function () {

        if (
            emChatNotification &&
            emChatWindow &&
            !emChatWindow.classList.contains(
                "em-chat-open"
            )
        ) {

            emChatNotification.style.display =
                "flex";

        }

    }, 8000);


    /* =====================================================
       ESC KEY
    ===================================================== */

    document.addEventListener(
        "keydown",
        function (event) {

            if (event.key !== "Escape") {
                return;
            }

            emCloseChat();

            emCloseEnquiry();

        }
    );


    /* =====================================================
       PREVENT BACKGROUND SCROLL WHEN MODAL OPEN
    ===================================================== */

    window.addEventListener(
        "beforeunload",
        function () {

            document.body.style.overflow = "";

        }
    );


})();