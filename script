       CHAT CLOSE
    ===================================================== */

    window.emCloseChat = function () {

        if (!emChatWindow) return;

        emChatWindow.classList.remove("em-chat-open");

        emChatWindow.setAttribute(
            "aria-hidden",
            "true"
        );

    };


    /* =====================================================
       NOTIFICATION CLOSE
    ===================================================== */

    window.emCloseNotification = function (event) {

        if (event) {
            event.stopPropagation();
