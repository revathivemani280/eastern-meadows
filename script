    /* =====================================================
       ADD USER MESSAGE
    ===================================================== */

    function emAddUserMessage(text) {

        if (!emChatBody) return;

        const wrapper =
            document.createElement("div");

        wrapper.className =
            "em-user-message";

        wrapper.innerHTML = `
            <div class="em-user-bubble">
                ${emEscapeHTML(text)}
            </div>
        `;

        emChatBody.appendChild(wrapper);

        emScrollChat();

    }


    /* =====================================================
       ADD BOT MESSAGE
    ===================================================== */

    function emAddBotMessage(html) {

        if (!emChatBody) return;

        const wrapper =
            document.createElement("div");

        wrapper.className =
            "em-bot-response";

        wrapper.innerHTML = `

            <div class="em-message-avatar">
                E
            </div>

            <div class="em-message-content">

                <span class="em-message-time">
                    Eastern Meadows Assistant
                </span>

                <div class="em-message-bubble">
