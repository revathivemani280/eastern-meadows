/* -----------------------------------------
   AUTO OPEN CHAT
----------------------------------------- */

window.addEventListener("load", function () {

    setTimeout(function () {

        const chatPopup =
            document.getElementById("chatPopup");

        if (chatPopup) {

            chatPopup.classList.add("active");

        }

